# API Laravel (servidor)
API_URL=http://localhost:8000
FRONTEND_API_KEY=
# API Laravel (navegador: formularios e downloads)
NEXT_PUBLIC_API_URL=http://localhost:8000

SITE_URL=http://localhost:3000
SITE_ENV=local
NEXT_PUBLIC_SITE_LOCALES=pt,en

# Mesmo valor de FRONTEND_REVALIDATE_SECRET na API
REVALIDATE_SECRET=

# Staging: autenticacao HTTP
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# Cloudflare Turnstile (vazio = sem desafio)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# CI: permite build sem API no ar (paginas saem vazias)
ALLOW_BUILD_WITHOUT_API=false
