# Variáveis do preview em containers (compose.preview.yaml e EasyPanel). Copie para .env.preview e preencha.
# Segredos: gere com `openssl rand -hex 32`. Senhas e segredos só com letras e números: o EasyPanel corta o valor
# no `#`. Nunca commitar o .env.preview.

# URLs públicas (no EasyPanel, os domínios de cada serviço)
API_PUBLIC_URL=http://localhost:8000
SITE_PUBLIC_URL=http://localhost:3000

# --- API ---
APP_NAME=Franccino
# Vazio = gerada no primeiro início e guardada no volume
APP_KEY=
APP_LOCALE=pt_BR
APP_LOCALES=pt,en
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Zip de `php artisan franccino:snapshot export`, importado uma vez só no primeiro início (opcional)
SNAPSHOT_URL=
MAIL_MAILER=log

# --- Segredos compartilhados entre API e site (mesmo valor nos dois) ---
FRONTEND_API_KEY=
FRONTEND_REVALIDATE_SECRET=
REVALIDATE_SECRET=

# --- Site ---
SITE_ENV=staging
NEXT_PUBLIC_SITE_LOCALES=pt,en
# Senha do preview (usuário e senha que o cliente digita para ver o site)
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GTM_ID=
